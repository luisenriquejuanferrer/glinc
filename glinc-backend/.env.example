# glinc-backend — Variables de entorno opcionales
#
# El backend funciona sin tocar nada si en tu maquina hay:
#   - PostgreSQL en localhost:5432 con BD "glinc", usuario "postgres", password "admin"
#   - El bridge corriendo en http://localhost:3001 con SERVICE_TOKENS que incluya "token-interno-1"
#
# Si tu setup difiere, exporta las variables ANTES de arrancar Spring Boot.
# En PowerShell:  $env:DB_PASSWORD = "otraPwd"
# En CMD:         set DB_PASSWORD=otraPwd
# En bash:        export DB_PASSWORD=otraPwd

# ─── Base de datos PostgreSQL ────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/glinc
DB_USER=postgres
DB_PASSWORD=admin

# ─── Bridge (cgm-bridge-service) ─────────────────────────────────
# Debe coincidir con uno de los tokens del array SERVICE_TOKENS del bridge.
BRIDGE_URL=http://localhost:3001
BRIDGE_SERVICE_TOKEN=token-interno-1
