# cgm-bridge-service — Variables de entorno
#
# Copia este archivo a ".env" y ajusta los valores que necesites.
# Todas son opcionales: el bridge arranca con defaults razonables si
# no defines ninguna.

# ─── Servidor ────────────────────────────────────────────────────
PORT=3001

# ─── Auth M2M con el backend (Spring Boot) ───────────────────────
# CSV de tokens validos. El backend (glinc-backend) manda uno de
# estos como "Authorization: Bearer <token>". Si dejas la lista vacia
# el bridge funciona SIN auth — solo para desarrollo local.
SERVICE_TOKENS=token-interno-1,token-interno-2

# ─── LibreLink Up ────────────────────────────────────────────────
# Version del cliente movil que la libreria suplanta. Subir solo si
# Abbott obliga a una version mas nueva.
LLU_VERSION=4.16.0

# ─── Cadencia y caches (no tocar salvo necesidad) ────────────────
STREAM_INTERVAL_MS=90000
SESSION_TTL_MS=43200000
RAW_CACHE_TTL_MS=30000
HISTORY_CACHE_TTL_MS=180000
PATIENTS_CACHE_TTL_MS=600000
RECONNECT_BASE_DELAY_MS=2000
MAX_RECONNECT_DELAY_MS=300000
